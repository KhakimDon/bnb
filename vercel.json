{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bb-coffee.uic.group/api/:path*" },
    { "source": "/media/:path*", "destination": "https://bb-coffee.uic.group/media/:path*" },
    { "source": "/static/:path*", "destination": "https://bb-coffee.uic.group/static/:path*" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
