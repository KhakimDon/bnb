# Приложение обращается к /api,/media,/static того же домена — проксируем на бэкенд.
/api/*     https://bb-coffee.uic.group/api/:splat     200
/media/*   https://bb-coffee.uic.group/media/:splat   200
/static/*  https://bb-coffee.uic.group/static/:splat  200

# Старые наклейки на столах: bnb.uz/app/?b=…&t=… — тот же SPA в корне.
/app/*     /:splat   200
/app       /         200

# SPA-фолбэк: всё остальное (кроме реальных файлов) — index.html.
/*         /index.html   200
