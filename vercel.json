{
  "routes": [
    { "src": "/api/(.*)", "dest": "https://bb-coffee.uic.group/api/$1" },
    { "src": "/media/(.*)", "dest": "https://bb-coffee.uic.group/media/$1" },
    { "src": "/static/(.*)", "dest": "https://bb-coffee.uic.group/static/$1" },
    { "src": "/\\.well-known/apple-app-site-association", "headers": { "content-type": "application/json" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
